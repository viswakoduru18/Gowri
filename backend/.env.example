# ── Server ────────────────────────────────────────────────────────────
PORT=8080
# Public URL of this backend (used for the payment page and return URLs)
PUBLIC_BASE_URL=http://localhost:8080
# Long random string; signs customer session tokens
JWT_SECRET=change-me-to-64-random-chars

# ── Zoho OAuth (Self Client, api-console.zoho.in) ─────────────────────
# Data-centre domains. India: zoho.in / zohoapis.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Refresh token generated with scopes:
#   ZohoInventory.items.READ,ZohoInventory.contacts.ALL,ZohoInventory.salesorders.ALL,
#   ZohoInventory.packages.READ,ZohoInventory.shipmentorders.READ,ZohoInventory.invoices.READ,
#   ZohoInventory.salesreturns.CREATE,ZohoPay.payments.CREATE,ZohoPay.payments.READ
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Item custom fields (api_name as shown in Zoho Inventory > Settings > Items > Custom fields)
ZOHO_CF_MRP=cf_mrp
ZOHO_CF_CONCERN=cf_concern
ZOHO_CF_PACK_SIZE=cf_pack_size
ZOHO_CF_HOW_TO_USE=cf_how_to_use
ZOHO_CF_INGREDIENTS=cf_ingredients
ZOHO_CF_GOOD_TO_KNOW=cf_good_to_know
# Only items whose category (or group) is listed here are sold in the app; empty = all active items
ZOHO_SELLABLE_CATEGORIES=
# Items carrying this custom field = "true" are shown in Best sellers / Recommended
ZOHO_CF_BEST_SELLER=cf_best_seller
ZOHO_CF_RECOMMENDED=cf_recommended
# Name of the shipping charge / COD fee line and default warehouse label
ZOHO_WAREHOUSE_LABEL=Hyderabad
# Seconds to cache the catalog (Zoho rate limits: ~100 req/min per org)
CATALOG_CACHE_SECONDS=60

# ── Zoho Payments ─────────────────────────────────────────────────────
ZOHO_PAYMENTS_URL=https://payments.zoho.in
ZOHO_PAYMENTS_ACCOUNT_ID=
# Publishable API key used by the checkout widget on the payment page
ZOHO_PAYMENTS_API_KEY=
# Signing key for webhook verification (Zoho Payments > Settings > Webhooks)
ZOHO_PAYMENTS_WEBHOOK_SECRET=

# ── Pidge last-mile delivery ───────────────────────────────────────────
# A Pidge trip is booked automatically when a Zoho Sales Order is confirmed.
# Leave PIDGE_USERNAME/PIDGE_API_TOKEN empty to skip Pidge (orders then track from Zoho packages/shipments only).
PIDGE_BASE_URL=https://api.pidge.in
PIDGE_USERNAME=
PIDGE_PASSWORD=
PIDGE_API_TOKEN=
PIDGE_CHANNEL=gowri-app
# Confirm these paths against the API reference Pidge shares with your account
PIDGE_LOGIN_PATH=/v1.0/store/channel/vendor/login
PIDGE_CREATE_PATH=/v1.0/store/channel/vendor/order
PIDGE_STATUS_PATH=/v1.0/store/channel/vendor/order/:id
# Shared secret; give Pidge this webhook URL: <PUBLIC_BASE_URL>/webhooks/pidge
PIDGE_WEBHOOK_TOKEN=
# Warehouse the rider picks up from
PIDGE_PICKUP_NAME=Gowri Warehouse
PIDGE_PICKUP_MOBILE=
PIDGE_PICKUP_ADDRESS=
PIDGE_PICKUP_CITY=Hyderabad
PIDGE_PICKUP_STATE=Telangana
PIDGE_PICKUP_PINCODE=

# ── OTP / SMS ─────────────────────────────────────────────────────────
# "console" logs codes to stdout (dev only). "msg91" sends real SMS.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
